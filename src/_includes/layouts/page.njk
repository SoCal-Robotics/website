---
layout: layouts/base.njk
---
<header class="page-hero wrapper"><div class="inner"><p class="eyebrow">{{ eyebrow or title }}</p><h1>{{ heading or title }}</h1><p>{{ description }}</p></div></header>
{% if sections %}<nav class="section-nav" aria-label="On this page"><div class="inner">{% for section in sections %}<a href="#{{ section.id }}">{{ section.label }}</a>{% endfor %}</div></nav>{% endif %}
<div class="wrapper page-body"><div class="inner page-grid"><article class="prose">{{ content | safe }}
{% if action == 'donate' %}<div class="action-box">{% if site.donationUrl %}<a class="button primary" href="{{ site.donationUrl }}">Donate securely <span aria-hidden="true">↗</span></a>{% else %}<p>{{ actionNote }}</p><a class="button primary" href="mailto:{{ site.email }}?subject=Donation%20inquiry">{{ actionLabel }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% endif %}
{% if action == 'apply' %}<div class="action-box">{% if site.applicationUrl %}<a class="button primary" href="{{ site.applicationUrl }}">Start an application <span aria-hidden="true">↗</span></a>{% else %}<p>{{ actionNote }}</p><a class="button primary" href="mailto:{{ site.email }}?subject=Student%20support%20inquiry">{{ actionLabel }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% endif %}
</article>{% if aside %}<aside class="page-aside"><p class="eyebrow">{{ aside.eyebrow }}</p><h2>{{ aside.title }}</h2><p>{{ aside.description }}</p><a class="text-link" href="{{ aside.url }}">{{ aside.label }} <span aria-hidden="true">↗</span></a></aside>{% endif %}</div></div>
{% if showStories %}<section class="wrapper impact-section" id="students-teams-we-support" aria-labelledby="stories-title"><div class="inner"><p class="eyebrow">{{ storiesEyebrow }}</p><h2 id="stories-title">{{ storiesTitle }}</h2>{% include 'components/stories.njk' %}</div></section>{% endif %}
