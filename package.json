    "test:browser": "playwright test",
    "prebuild": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2",
    "cheerio": "1.1.2"
  }
}
