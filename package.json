{
  "name": "socal-robotics-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --port=8080",
    "build": "eleventy",
    "check": "node scripts/check-site.mjs",
